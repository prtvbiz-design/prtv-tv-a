<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!--
      required="false" во всех трёх случаях. Любое required="true" здесь
      делает приложение неустанавливаемым на часть приставок: система
      отфильтровывает устройства без заявленной аппаратной возможности.
    -->
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <uses-feature android:name="android.hardware.usb.host" android:required="false"/>
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!--
          Обе категории обязательны: LEANBACK_LAUNCHER для лаунчера Android TV,
          LAUNCHER для приставок и телефонов с обычным лаунчером.
          Имена классов полные — namespace и applicationId могут разойтись.
        -->
        <activity
            android:name="pro.prtv.tva.StartActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:name="pro.prtv.tva.PlayerActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/PlayerTheme"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|uiMode"/>
        <activity
            android:name="pro.prtv.tva.DiagActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|uiMode"/>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/field_bg_active"/>
            <stroke android:width="3dp" android:color="@color/field_border_focus"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/field_bg_active"/>
            <stroke android:width="2dp" android:color="@color/field_border"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/neutral_button"/>
            <stroke android:width="4dp" android:color="@color/focus_ring"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/neutral_button"/>
            <stroke android:width="1dp" android:color="@color/neutral_button_border"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!--
  «Системные данные». В боевом приложении за этой кнопкой системный статус
  и таблица хранилищ. Здесь то же самое плюс раздел доктора.
  Доктор живёт именно тут, а не отдельной кнопкой на главном экране:
  проверка нагружает устройство и не должна запускаться случайно.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screen_bg"
    android:paddingStart="40dp"
    android:paddingEnd="40dp"
    android:paddingTop="26dp"
    android:paddingBottom="20dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/system_data"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"/>
        <Button android:id="@+id/btnBack" style="@style/PanelButton"
            android:text="@string/back"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">
        <!-- Слева: статус и доктор -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_weight="45"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView style="@style/SectionTitle"
                    android:text="@string/system_status_title"/>
                <TextView
                    android:id="@+id/systemStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:fontFamily="monospace"/>
                <TextView style="@style/SectionTitle"
                    android:text="@string/doctor_title"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/doctor_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"/>
                <Button
                    android:id="@+id/btnRunDoctor"
                    style="@style/PanelButton"
                    android:layout_marginTop="8dp"
                    android:text="@string/doctor_run"/>
            </LinearLayout>
        </ScrollView>
        <!-- Справа: журнал -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="55"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginStart="24dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView style="@style/SectionTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/event_log"/>
                <Button android:id="@+id/btnClearLog" style="@style/PanelButton"
                    android:text="@string/clear_log"/>
            </LinearLayout>
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp">
                <TextView
                    android:id="@+id/eventLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/log_text"
                    android:textSize="13sp"
                    android:fontFamily="monospace"/>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

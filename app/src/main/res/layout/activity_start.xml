<?xml version="1.0" encoding="utf-8"?>
<!--
  Главный экран. Макет повторяет StartScreen приложения:
  тёмный фон, колонка настроек, фотопанель с полями ввода.
  Пропорции колонок и отступы взяты из макета в процентах экрана и
  переведены в веса. Точная сверка «пиксель в пиксель» возможна только
  по снимкам с телевизора — до неё макет считается приближением.
  Все элементы фокусируемые: экран управляется пультом, а не касанием.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/screen_bg">
    <!-- ═══ Колонка настроек ═══ -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_weight="32"
        android:layout_height="match_parent"
        android:background="@color/panel_bg"
        android:paddingStart="26dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_tagline"
                android:textColor="@color/text_muted"
                android:textSize="13sp"/>
            <TextView
                style="@style/SectionTitle"
                android:text="@string/section_settings"/>
            <TextView style="@style/FieldLabel" android:text="@string/language"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnLangRu"
                    style="@style/PanelButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/lang_ru"/>
                <Button
                    android:id="@+id/btnLangEn"
                    style="@style/PanelButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/lang_en"/>
            </LinearLayout>
            <!-- Хоста в макете нет: в боевом приложении он вшит.
                 Здесь это ключевой параметр сравнения. -->
            <TextView style="@style/FieldLabel" android:text="@string/host"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btnHostSu" style="@style/PanelButton"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:text="@string/host_su"/>
                <Button android:id="@+id/btnHostPro" style="@style/PanelButton"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/host_pro"/>
                <Button android:id="@+id/btnHostTest" style="@style/PanelButton"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/host_test"/>
            </LinearLayout>
            <TextView style="@style/SectionTitle" android:text="@string/cache_title"/>
            <Button
                android:id="@+id/btnCacheToggle"
                style="@style/PanelButton"
                android:layout_width="match_parent"
                android:text="@string/cache_enable"/>
            <TextView style="@style/FieldLabel" android:text="@string/cache_photo_threshold"/>
            <EditText
                android:id="@+id/inputCacheThreshold"
                style="@style/PanelField"
                android:inputType="number"
                android:hint="@string/cache_threshold_hint"
                android:importantForAutofill="no"/>
            <Button
                android:id="@+id/btnCacheClear"
                style="@style/PanelButton"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:text="@string/cache_clear"/>
            <TextView
                android:id="@+id/cacheStats"
                style="@style/FieldLabel"
                android:text="@string/cache_stats_empty"/>
            <TextView style="@style/SectionTitle" android:text="@string/sleep_title"/>
            <Button
                android:id="@+id/btnSleepToggle"
                style="@style/PanelButton"
                android:layout_width="match_parent"
                android:text="@string/sleep_off"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <LinearLayout
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView style="@style/FieldLabel" android:text="@string/turn_on_at"/>
                    <EditText android:id="@+id/inputWakeAt" style="@style/PanelField"
                        android:inputType="time" android:hint="@string/time_hint"
                        android:importantForAutofill="no"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:layout_marginStart="8dp">
                    <TextView style="@style/FieldLabel" android:text="@string/turn_off_at"/>
                    <EditText android:id="@+id/inputSleepAt" style="@style/PanelField"
                        android:inputType="time" android:hint="@string/time_hint"
                        android:importantForAutofill="no"/>
                </LinearLayout>
            </LinearLayout>
            <!-- За этой кнопкой живёт и доктор -->
            <Button
                android:id="@+id/btnSystemData"
                style="@style/PanelButton"
                android:layout_width="match_parent"
                android:layout_marginTop="20dp"
                android:text="@string/system_data"/>
            <TextView
                android:id="@+id/versionLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/text_muted"
                android:textSize="11sp"/>
        </LinearLayout>
    </ScrollView>
    <!-- ═══ Фотопанель с полями ввода ═══ -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_weight="68"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/start_photo"
            android:contentDescription="@null"/>
        <!-- Затемнение: поверх фотографии текст должен читаться -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="44dp"
            android:paddingEnd="44dp"
            android:paddingTop="30dp"
            android:paddingBottom="22dp">
            <ImageView
                android:layout_width="220dp"
                android:layout_height="36dp"
                android:src="@drawable/prtv_logo_header"
                android:scaleType="fitStart"
                android:contentDescription="@null"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/start_title"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/instructions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"/>
            <!-- Три поля: зелёная, жёлтая, красная кнопки пульта -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:orientation="horizontal">
                <LinearLayout style="@style/InputCell">
                    <TextView style="@style/InputTopLabel" android:text="@string/input_slideshow"/>
                    <EditText android:id="@+id/inputSlideshow" style="@style/CodeField"
                        android:hint="@string/hint_slideshow" android:importantForAutofill="no"
                        android:singleLine="true" android:imeOptions="actionDone"/>
                    <LinearLayout style="@style/HintRow">
                        <View style="@style/HintDot" android:background="@drawable/dot_green"/>
                        <TextView style="@style/HintText" android:text="@string/hint_green"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout style="@style/InputCell" android:layout_marginStart="18dp">
                    <TextView style="@style/InputTopLabel" android:text="@string/input_stream"/>
                    <EditText android:id="@+id/inputStream" style="@style/CodeField"
                        android:hint="@string/hint_stream" android:importantForAutofill="no"
                        android:singleLine="true" android:imeOptions="actionDone"/>
                    <LinearLayout style="@style/HintRow">
                        <View style="@style/HintDot" android:background="@drawable/dot_yellow"/>
                        <TextView style="@style/HintText" android:text="@string/hint_yellow"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout style="@style/InputCell" android:layout_marginStart="18dp">
                    <TextView style="@style/InputTopLabel" android:text="@string/input_set"/>
                    <EditText android:id="@+id/inputSet" style="@style/CodeField"
                        android:maxLength="7"
                        android:hint="@string/hint_set" android:importantForAutofill="no"
                        android:singleLine="true" android:imeOptions="actionDone"/>
                    <LinearLayout style="@style/HintRow">
                        <View style="@style/HintDot" android:background="@drawable/dot_red"/>
                        <TextView style="@style/HintText" android:text="@string/hint_red"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <Button
                android:id="@+id/btnUsbSlideshow"
                style="@style/PanelButton"
                android:layout_width="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/usb_slideshow"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <!-- Пресеты сравнения. Технический элемент, не для клиента. -->
            <LinearLayout
                android:id="@+id/presetsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView style="@style/HintText" android:text="@string/presets"
                    android:layout_gravity="center_vertical"/>
                <Button android:id="@+id/presetCalendar" style="@style/PresetButton"
                    android:text="@string/preset_calendar"/>
                <Button android:id="@+id/presetPizza" style="@style/PresetButton"
                    android:text="@string/preset_pizza"/>
                <Button android:id="@+id/presetOlympic" style="@style/PresetButton"
                    android:text="@string/preset_olympic"/>
            </LinearLayout>
            <TextView
                android:id="@+id/deviceLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_muted"
                android:textSize="11sp"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>

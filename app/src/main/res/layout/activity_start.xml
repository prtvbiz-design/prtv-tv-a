<?xml version="1.0" encoding="utf-8"?>
<!--
  Главный экран. Раскладка повторяет боевое приложение: одно тёмное
  полотно, рабочая колонка слева, панель изображения справа во всю высоту.

  Порядок сверху вниз: шапка, ввод, настройки, инструкции, служебное.
  Прокрутки нет и быть не должно — экран настройки смотрят один раз,
  и в этот раз всё должно быть видно сразу.

  Высотный бюджет: телевизор 1080p при плотности xhdpi даёт 960×540 dp.
  Сумма блоков ниже укладывается примерно в 500 dp вместе с отступами.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/screen_bg">

    <!-- ═══════════ рабочая колонка ═══════════ -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="62"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="34dp"
        android:paddingEnd="26dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp">

        <!-- ─── шапка ─── -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="128dp"
                android:layout_height="22dp"
                android:scaleType="fitStart"
                android:src="@drawable/prtv_logo_header"
                android:contentDescription="@null"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/brand_tagline"
                android:textColor="@color/text_muted"
                android:textSize="13sp"/>
        </LinearLayout>

        <!-- ─── ввод ─── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout style="@style/InputCell">
                <TextView style="@style/InputTopLabel" android:text="@string/input_slideshow"/>
                <EditText android:id="@+id/inputSlideshow" style="@style/CodeField"
                    android:hint="@string/hint_slideshow"
                    android:singleLine="true" android:imeOptions="actionDone"/>
                <LinearLayout style="@style/HintRow">
                    <View style="@style/HintDot" android:background="@drawable/dot_green"/>
                    <TextView style="@style/HintText" android:text="@string/hint_green"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/InputCell" android:layout_marginStart="14dp">
                <TextView style="@style/InputTopLabel" android:text="@string/input_stream"/>
                <EditText android:id="@+id/inputStream" style="@style/CodeField"
                    android:hint="@string/hint_stream"
                    android:singleLine="true" android:imeOptions="actionDone"/>
                <LinearLayout style="@style/HintRow">
                    <View style="@style/HintDot" android:background="@drawable/dot_yellow"/>
                    <TextView style="@style/HintText" android:text="@string/hint_yellow"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/InputCell" android:layout_marginStart="14dp">
                <TextView style="@style/InputTopLabel" android:text="@string/input_set"/>
                <EditText android:id="@+id/inputSet" style="@style/CodeField"
                    android:hint="@string/hint_set"
                    android:singleLine="true" android:imeOptions="actionDone"/>
                <LinearLayout style="@style/HintRow">
                    <View style="@style/HintDot" android:background="@drawable/dot_red"/>
                    <TextView style="@style/HintText" android:text="@string/hint_red"/>
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnUsbSlideshow"
                style="@style/PanelButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:layout_marginTop="20dp"
                android:text="@string/usb_slideshow"/>
        </LinearLayout>

        <!-- ─── настройки ─── -->
        <TextView style="@style/SectionTitle" android:text="@string/section_settings"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView style="@style/FieldLabel" android:text="@string/language"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button android:id="@+id/btnLangRu" style="@style/PanelButton"
                        android:minWidth="96dp" android:text="@string/lang_ru"/>
                    <Button android:id="@+id/btnLangEn" style="@style/PanelButton"
                        android:layout_marginStart="8dp"
                        android:minWidth="96dp" android:text="@string/lang_en"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView style="@style/FieldLabel" android:text="@string/cache_title"/>
                    <Switch android:id="@+id/switchCache" style="@style/PanelSwitch"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Spinner android:id="@+id/inputCacheThreshold"
                        android:layout_width="140dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/field_bg"
                        android:popupBackground="@color/panel_bg"/>
                    <Button android:id="@+id/btnCacheClear" style="@style/PanelButton"
                        android:layout_marginStart="8dp"
                        android:text="@string/cache_clear"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ─── режим сна ─── -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView style="@style/FieldLabel" android:text="@string/sleep_title"/>
            <Switch android:id="@+id/switchSleep" style="@style/PanelSwitch"/>
            <TextView
                android:id="@+id/sleepNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:visibility="gone"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView style="@style/FieldLabel" android:text="@string/turn_on_at"/>
                <EditText android:id="@+id/inputWakeAt" style="@style/PanelField"
                    android:layout_width="112dp"
                    android:hint="@string/time_hint"
                    android:singleLine="true" android:imeOptions="actionDone"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:orientation="vertical">
                <TextView style="@style/FieldLabel" android:text="@string/turn_off_at"/>
                <EditText android:id="@+id/inputSleepAt" style="@style/PanelField"
                    android:layout_width="112dp"
                    android:hint="@string/time_hint"
                    android:singleLine="true" android:imeOptions="actionDone"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ─── инструкции ─── -->
        <TextView style="@style/SectionTitle" android:text="@string/instructions_title"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="56dp" android:layout_height="56dp"
                android:src="@drawable/dpad_slides"
                android:contentDescription="@null"/>
            <TextView style="@style/HintText"
                android:layout_width="76dp"
                android:text="@string/instr_switch_slides"/>

            <ImageView
                android:layout_width="56dp" android:layout_height="56dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/dpad_within"
                android:contentDescription="@null"/>
            <TextView style="@style/HintText"
                android:layout_width="76dp"
                android:text="@string/instr_move_within"/>

            <ImageView
                android:layout_width="56dp" android:layout_height="56dp"
                android:layout_marginStart="20dp"
                android:src="@drawable/qr_help"
                android:contentDescription="@null"/>
            <TextView style="@style/HintText"
                android:layout_width="150dp"
                android:text="@string/instr_qr"/>
        </LinearLayout>

        <!-- ─── служебное ─── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btnSystemData"
            style="@style/PanelButton"
            android:text="@string/system_data"/>

        <TextView
            android:id="@+id/statusLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_muted"
            android:textSize="10sp"/>
    </LinearLayout>

    <!-- ═══════════ панель изображения ═══════════ -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_weight="38"
        android:layout_height="match_parent">
        <!--
          Две картинки одна поверх другой: смена идёт перекрёстным
          затуханием, поэтому в момент перехода нужны обе.
        -->
        <ImageView
            android:id="@+id/panelBack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/panel_1"
            android:contentDescription="@null"/>
        <ImageView
            android:id="@+id/panelFront"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:alpha="0"
            android:contentDescription="@null"/>
        <!-- Затемнение: панель не должна перетягивать внимание с фокуса -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#4D000000"/>
    </FrameLayout>
</LinearLayout>

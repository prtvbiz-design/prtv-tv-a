<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101014"
    android:padding="48dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="34sp"/>
        <TextView
            android:id="@+id/deviceLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#8A8A96"
            android:textSize="15sp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/host"
            android:textColor="#8A8A96"
            android:textSize="16sp"/>
        <RadioGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/hostSu" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="prtv.su"
                android:textColor="#FFFFFF" android:textSize="17sp"/>
            <RadioButton android:id="@+id/hostPro" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="26dp"
                android:text="prtv.pro" android:textColor="#FFFFFF" android:textSize="17sp"/>
            <RadioButton android:id="@+id/hostNewTest" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="26dp"
                android:text="new-test" android:textColor="#FFFFFF" android:textSize="17sp"/>
        </RadioGroup>
        <LinearLayout
            android:id="@+id/presetsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <Button android:id="@+id/presetCalendar" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/preset_calendar"/>
            <Button android:id="@+id/presetPizza" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="10dp"
                android:text="@string/preset_pizza"/>
            <Button android:id="@+id/presetOlympic" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="10dp"
                android:text="@string/preset_olympic"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="26dp" android:text="@string/slideshow"
            android:textColor="#8A8A96" android:textSize="16sp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText android:id="@+id/inputSlideshow" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:inputType="number" android:textColor="#FFFFFF" android:textSize="22sp"
                android:hint="@string/hint_code" android:textColorHint="#55555F"
                android:importantForAutofill="no"/>
            <Button android:id="@+id/btnSlideshow" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="14dp"
                android:text="@string/show"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="@string/set"
            android:textColor="#8A8A96" android:textSize="16sp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText android:id="@+id/inputSet" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:inputType="number" android:textColor="#FFFFFF" android:textSize="22sp"
                android:hint="@string/hint_code" android:textColorHint="#55555F"
                android:importantForAutofill="no"/>
            <Button android:id="@+id/btnSet" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="14dp"
                android:text="@string/show"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="@string/stream"
            android:textColor="#8A8A96" android:textSize="16sp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText android:id="@+id/inputStream" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:inputType="number" android:textColor="#FFFFFF" android:textSize="22sp"
                android:hint="@string/hint_code" android:textColorHint="#55555F"
                android:importantForAutofill="no"/>
            <Button android:id="@+id/btnStream" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="14dp"
                android:text="@string/show"/>
        </LinearLayout>
        <Button android:id="@+id/btnDiag" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="30dp"
            android:text="@string/diagnostics"/>
    </LinearLayout>
</ScrollView>
